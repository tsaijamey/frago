{
  "manifest_version": 3,
  "name": "frago bridge",
  "version": "0.4.0",
  "description": "frago agent OS — browser bridge & session context panel.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "nativeMessaging",
    "debugger",
    "tabCapture",
    "offscreen",
    "tabGroups",
    "alarms",
    "proxy",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker-v14.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/page_extractor.js",
        "content/picker.js",
        "content/content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "frago bridge"
  },
  "options_page": "options/options.html"
}
