# ~/.frago gitignore template
# 此文件是 ~/.frago/.gitignore 的权威模板，由 frago init 写入。
#
# 往 ~/.frago/ 新增文件时，MUST 判断是否加到这里：
#   设备本地运行时产物（cache、state、log、pid）→ 加
#   跨设备共享资源（recipes/、定义文件）→ 不加

# Runtime data (not synced)
sessions/
sessions.json
executions/
ingested_tasks.json
message_cache.json
traces/
threads/
# CDP browser profiles: new nested layout (profiles/<browser>/<port>)
profiles/
# Legacy flat names kept during transition (existing profiles still at top level)
chrome_profile/
chrome_profile_*/
edge_profile/
edge_profile_*/
chromium_profile/
chromium_profile_*/
chrome/extension-profile/
current_run
projects/.tmp/
projects/**/screenshots/
projects/**/logs/
# Run instance binary/cache artifacts under both legacy projects/{session}/...
# and domain layout projects/{domain}/{session}/... (commit 1a66bc7).
# metadata.json / steps.jsonl / summary.{json,md} / _domain.json / insights/
# are still synced as text-only run state.
projects/**/chrome_profile/
projects/**/chrome_profile_*/
projects/**/chrome_profile2/
projects/**/temp/
projects/**/outputs/
projects/**/.cache/
projects/**/.git/
runtime.json
runtime.json.bak.*
# frago 会话标识 → opencode 原生会话 id 的映射。指向本机 opencode.db 里的行，
# 换台设备毫无意义，故不同步。
opencode-sessions.json

# Cache directories (device-local, not synced)
cache/

# Commands directory (managed by frago itself, not synced)
.claude/commands/

# Local metadata (device-specific, not synced)
.claude/settings.local.json
.device_id
.workspace_migrated
.api_endpoint_migrated
.cache/

# Config files (contain sensitive information or device-specific)
config.json
gui_config.json
profiles.json
recipes.local.json

# Credentials. These are the same files frago.server.security chmods to 0600 at
# startup because possessing one is possessing the thing it names — keep the two
# lists together, or a file gets locked down on disk and published to git in the
# same release.
#   server-token   本机 API 的 bearer，拿到它等于拿到这台机器上的 /api
#   remotes.json   其他机器的 url + token
#   config.yaml    frago cloud 的 access / refresh token
#   users.json     账号口令散列
#   login-sessions 会话文件，持有即等于持有它指向的账号
server-token
remotes.json
config.yaml
users.json
users.json.lock
login-sessions/

# Which pages this server has exposed, and to whom. Device-local: another
# machine publishes its own set.
published.json

# frago 会话标识 → codex 原生会话 id 的映射。同 opencode-sessions.json 的道理：
# 指向本机的 codex 状态，换台设备毫无意义。
codex-sessions.json

# Environment variable files (sensitive information)
.env
.env.*
.env.local
.env.*.local

# System files
.DS_Store
__pycache__/
*.pyc
*.bak
*.bak.*
server.pid
server.log*
gui_history.jsonl

# Conflict backup files (temporary)
*.LOCAL
*.REMOTE
*.sync-backup
*.sync-backup.local
*.sync-backup.remote

# Video files
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm

# Audio files
*.wav
*.mp3
*.aac
*.flac
*.ogg
*.m4a

# Log files
logs/
*.log
# Rotated logs. `*.log` does not match `hook-rules-hits.log.1`, so without this
# every rotation leaves another multi-megabyte file offered up for commit.
*.log.[0-9]*

# Archives and other large files
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.pdf
*.psd
*.ai

# Recipe-scoped project runtime artifacts (not synced)
# Text state (project.json / script.md / manifest.json) under _projects/
# IS synced; only binary / cacheable artifacts below are excluded.
recipes/*/*/_projects/**/assets/
recipes/*/*/_projects/**/tts/
recipes/*/*/_projects/**/html/
recipes/*/*/_projects/**/logs/
recipes/*/*/_projects/**/*.mp4
recipes/*/*/_projects/**/*.png
recipes/*/*/_projects/**/*.jpg
recipes/*/*/_projects/**/*.jpeg
recipes/*/*/_projects/**/*.webp
recipes/*/*/_projects/**/*.wav
