          "src/frago/agent_driver/driver.py#AgentDriver",
          "src/frago/agent_driver/kernel_backend.py"
        ],
        "description": "承载 AgentKernel 运行的物理执行底座（Harness）：分 Tmux 交互式终端槽位（含输入注入、就绪/完成探针、异常模态处理）与无屏一次性子进程槽位两类。"
      },
      {
        "class_id": "RecipeModule",
        "rigidity": "+R",
        "identity": "recipe_name",
        "current_code_locations": [
          "src/frago/recipes/registry.py",
          "src/frago/recipes/metadata.py"
        ],
        "description": "跑通一次后固化成确定性代码的工具模块（atomic / workflow），拥有独立目录、脚本入口与可选前端资产。"
      },
      {
        "class_id": "DataSlot",
