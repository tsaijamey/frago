        ],
        "description": "跨会话交接单制品：记录是什么、到哪一步、下一步先动哪、怎么算完，并自动关联历经的 session_id 列表。"
      },
      {
        "class_id": "HumanDecisionReceipt",
        "identity": "decision_message_uuid",
