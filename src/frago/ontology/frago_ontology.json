        "description": "结论层召回入口（frago <domain> find/save）中的结构化知识条目。"
      },
      {
        "class_id": "SessionTranscriptArtifact",
        "identity": "session_id",
        "current_code_locations": [
          "src/frago/session/storage.py",
          "src/frago/session/search.py"
        ],
        "description": "过程层召回入口（frago session search）背后的双库备份会话轨迹文件（raw.jsonl / steps.jsonl）。"
      },
      {
        "class_id": "TodoHandoffArtifact",
        "identity": "todo_id",
        "current_code_locations": [
