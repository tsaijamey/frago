{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "ontology_id": "frago-agent-os-ontology",
  "ontology_version": "1.1.0",
  "description": "frago Agent OS 操作型本体（Operational Ontology）全量原始数据模型：覆盖五根支柱与全部 26 个子系统目录的业务概念，基于三轴正交超类、OntoClean 刚性公理、一等公民关系代数与三层同心圆动作契约。",
  "orthogonal_axes": {
    "mereotemporality": {
      "axiom": "∀t(E(x,t) → WhollyPresent(x,t))",
      "question": "实体在任意时间切片上是否完整存在，还是必须在时间流中展开？",
      "poles": ["Continuant", "Occurrent"]
    },
    "existential_dependence": {
      "axiom": "□(∀t(E(x,t) → ∃y(InheresIn(x,y,t))))",
      "question": "实体能否脱离宿主独立存在，还是必须依附于某个承载主体（Bearer）与作用域（Context）？",
      "poles": ["IndependentContinuant", "DependentContinuant"]
    },
    "direction_of_fit": {
      "axiom": "Searle Intentionality Fit (Reality vs. World-to-Mind vs. Mind-to-World)",
      "question": "它是运行时的客观实在，还是要求实在服从它的规范契约，还是表征实在的符号制品？",
      "poles": ["RealizableEntity", "NormativeEntity", "InformationEntity"]
    }
  },
  "upper_ontology": {
    "Thing": {
      "abstract": true,
      "subclasses": [
        "Continuant",
        "Occurrent",
        "NormativeEntity",
        "InformationEntity"
      ]
    },
    "Continuant": {
      "parent": "Thing",
      "axis_projection": {
        "mereotemporality": "wholly_present_at_snapshot",
        "direction_of_fit": "reality"
      },
      "subclasses": [
        "IndependentContinuant",
        "DependentContinuant"
      ],
      "IndependentContinuant": {
        "parent": "Continuant",
        "rigidity": "+R",
        "existential_dependence": "independent",
        "identity_criterion": "global_uid",
        "temporality": "snapshot",
        "mutability": "stateful_versioned",
        "storage_primitive": "StateStore (CRUD with optimistic lock / file lock)",
        "subclasses": ["Actor", "Resource"]
      },
      "DependentContinuant": {
        "parent": "Continuant",
        "rigidity": "~R",
        "existential_dependence": "requires_bearer_and_context",
        "identity_criterion": "composite(bearer_id, context_id, dependent_type)",
        "temporality": "context_scoped",
        "mutability": "lifecycle_bound",
        "ontological_guardrail": "Anti-rigid (~R) classes MUST NEVER be superclasses of Rigid (+R) classes.",
        "storage_primitive": "ContextBindingStore (ephemeral or session/scope-bound slots)",
        "subclasses": ["Role", "Capability", "QualityState"]
      }
    },
    "Occurrent": {
      "parent": "Thing",
      "axis_projection": {
        "mereotemporality": "unfolds_in_time_with_temporal_parts",
        "direction_of_fit": "reality"
      },
      "subclasses": ["Process", "Event"],
      "Process": {
        "parent": "Occurrent",
        "rigidity": "+R",
        "identity_criterion": "process_run_uid",
        "temporality": "interval(started_at, ended_at)",
        "mutability": "state_machine(pending -> running -> completed | error | cancelled)",
        "storage_primitive": "LifecycleEngine / ActiveProcessRegistry",
        "required_relations": ["initiated_by", "governed_by"]
      },
      "Event": {
        "parent": "Occurrent",
        "rigidity": "+R",
        "identity_criterion": "causal_hash(occurred_at, causal_source_id, payload_hash)",
        "temporality": "instant(occurred_at)",
        "mutability": "append_only_immutable",
        "storage_primitive": "AppendOnlyEventLog (JSONL trace / step stream)"
      }
    },
    "NormativeEntity": {
      "parent": "Thing",
      "rigidity": "+R",
      "axis_projection": {
        "direction_of_fit": "world_to_mind_directive"
      },
      "identity_criterion": "composite(norm_id, semantic_version)",
      "temporality": "effective_window(valid_from, valid_until)",
      "mutability": "versioned_immutable",
      "storage_primitive": "PolicyAndContractRegistry (AST / Rule & Guard Evaluator)",
      "subclasses": ["RulePolicy", "Contract", "Specification"]
    },
    "InformationEntity": {
      "parent": "Thing",
      "rigidity": "+R",
      "axis_projection": {
        "direction_of_fit": "mind_to_world_representation"
      },
      "identity_criterion": "content_hash_or_uri",
      "temporality": "versioned_snapshot",
      "mutability": "content_addressed_or_append_only",
      "storage_primitive": "CAS / MultiIndexRecallEngine (def / context / session search)",
      "subclasses": ["KnowledgeArtifact", "TranscriptArtifact", "CoordinationArtifact"]
    }
  },
  "relation_signatures": {
    "plays_role": {
      "domain": "IndependentContinuant",
      "range": "Role",
      "inverse": "borne_by",
      "algebraic_properties": ["asymmetric", "irreflexive"],
      "description": "刚性主体或资源在特定会话、请求或结对作用域中动态挂载反刚性角色。"
    },
    "has_capability": {
      "domain": "IndependentContinuant",
      "range": "Capability",
      "inverse": "capability_of",
      "algebraic_properties": ["asymmetric"],
      "description": "主体或资源声明其可被外部或 Harness 调用的能力切面。"
    },
    "exhibits_state": {
      "domain": "Continuant",
      "range": "QualityState",
      "inverse": "state_of",
      "algebraic_properties": ["functional"],
      "description": "延续体在当前时间切片呈现的状态、来源或安全区属性。"
    },
    "hosted_on_harness": {
      "domain": "Actor",
      "range": "Resource",
      "inverse": "hosts_actor",
      "algebraic_properties": ["asymmetric"],
      "description": "AI Agent 内核实例挂载于具体 Harness 载体（TmuxPane 或 SubprocessPipe）之上运行。"
    },
    "initiates": {
      "domain": "Actor | Role",
      "range": "Process",
      "inverse": "initiated_by",
      "algebraic_properties": ["asymmetric"],
      "description": "主体或角色拉起一个持续过程。"
    },
    "governed_by": {
      "domain": "Process | Role | NormativeEntity",
      "range": "NormativeEntity",
      "inverse": "governs",
      "algebraic_properties": ["asymmetric"],
      "description": "过程、角色或动作受规范体（Hook 规则、开放策略、结对安全规矩、定时规格、模块边界契约）约束。"
    },
    "mutates": {
      "domain": "Process | NormativeEntity",
      "range": "IndependentContinuant",
      "inverse": "mutated_by",
      "algebraic_properties": ["asymmetric"],
      "description": "过程或动作修改目标延续体的状态槽位。"
    },
    "emits": {
      "domain": "Process",
      "range": "Event",
      "inverse": "emitted_by",
      "algebraic_properties": ["asymmetric", "irreflexive"],
      "description": "持续过程在时间点上发射不可变的瞬时事件。"
    },
    "produces": {
      "domain": "Process",
      "range": "InformationEntity",
      "inverse": "produced_by",
      "algebraic_properties": ["asymmetric"],
      "description": "过程产出信息制品（轨迹记录、知识条目、待办交接卡、市场包、人类授权回执）。"
    },
    "depends_on_module": {
      "domain": "Resource | NormativeEntity",
      "range": "Resource | NormativeEntity",
      "inverse": "depended_on_by",
      "algebraic_properties": ["transitive", "irreflexive"],
      "description": "模块或配方间的有向依赖（含 recipe imports/reads_common 与 Python 包分层依赖），具有传递性且严禁成环。"
    }
  },
