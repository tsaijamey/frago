  "kinetic_action_contracts": [
    {
      "action_id": "execute_recipe_mode",
      "parameters": ["recipe_name", "mode_name", "params", "caller_identity"],
      "signature": {
        "initiator_domain": "CallerZoneRole | AgentKernel",
        "target_range": "RecipeModule",
        "input_types": {
          "recipe_name": "str",
          "mode_name": "str",
          "params": "dict[str, Any]",
          "caller_identity": "str"
        },
        "return_type": "RecipeExecutionResult",
        "error_types": ["RecipeValidationError", "PermissionDeniedError", "CommandGrantError"]
      },
      "contract": {
        "preconditions": [
          "caller_identity MUST be bound (owner local/token OR signed-in user_id OR shared public read).",
          "If caller exhibits SignedInVisitorRole, mode_name MUST have RecipeModeCapability in {'export_readonly', 'action_triggerable'} and be permitted by RecipeExposurePolicy.",
          "For every target in RecipeModule.reads_common, target RecipeModule.shares MUST declare a non-empty bounded subpath.",
          "For every cmd in RecipeModule.uses_commands, CommandGrantAuditedEvent MUST exist in machine grants.json."
        ],
        "postconditions": [
          "RecipeExecutionProcess transitions to 'succeeded' or 'failed'.",
          "Writes land strictly inside the bound DataSlot (users/<id>/ or app-state/), never crossing isolation view."
        ],
        "invariants": [
          "Identity data root (~/.frago/users/) and recipe code root (~/.frago/recipes/) remain disjoint.",
          "@export mode execution NEVER mutates DataSlot."
        ],
        "side_effects": {
          "initiates": "RecipeExecutionProcess",
          "mutates": ["DataSlot (only when mode_name is @action or owner run)"],
          "emits": ["SessionStepEvent"]
        }
      }
    },
    {
      "action_id": "drive_agent_turn",
      "parameters": ["session_id", "agent_kernel_id", "prompt_text", "profile_id"],
      "signature": {
        "initiator_domain": "PrimarySchedulerRole | HumanPrincipal",
        "target_range": "AgentHarness",
        "input_types": {
          "session_id": "str",
          "agent_kernel_id": "AgentType",
          "prompt_text": "str",
          "profile_id": "str | None"
        },
        "return_type": "CompletionVerdict",
        "error_types": ["AuthWallError", "HarnessTimeoutError", "DeadlockError"]
      },
      "contract": {
        "preconditions": [
          "Caller MUST NOT bear SubtaskWorkerRole (workers are prohibited from spawning nested agent sessions).",
          "AgentHarness MUST match ready_signal before submit is invoked.",
          "If session_id is resumed, target AgentSessionProcess MUST NOT be in 'running' state."
        ],
        "postconditions": [
          "HarnessTurnProcess yields CompletionVerdict with status in {'ok', 'needs_input', 'error'} and deduplicated turn marker.",
          "If output matches _AUTH_WALL or zero-char abnormal finish, status MUST be downgraded to 'needs_input' or 'error', NEVER 'ok'."
        ],
        "invariants": [
          "API secret keys in ApiProfile MUST only be injected via process environment or profile_id reference, NEVER echoed into tmux pane command line."
        ],
        "side_effects": {
          "initiates": "HarnessTurnProcess",
          "emits": ["HookLifecycleEvent", "SessionStepEvent"],
          "produces": ["SessionTranscriptArtifact"]
        }
      }
    },
    {
      "action_id": "execute_state_mutating_operation",
      "parameters": ["operation_name", "target_resource_id", "authorization_source"],
      "signature": {
        "initiator_domain": "AgentKernel",
        "target_range": "Resource | NormativeEntity",
        "input_types": {
          "operation_name": "str",
          "target_resource_id": "str",
          "authorization_source": "HumanDecisionReceipt | ExplicitUserCommandStep"
        },
        "return_type": "MutationReceipt",
        "error_types": ["UnauthorizedStateMutationError"]
      },
      "contract": {
        "preconditions": [
          "authorization_source MUST point to an explicit command in the current turn OR a HumanDecisionReceipt (【answer】) whose 'effect' text covers target_resource_id and operation_name.",
          "If instruction is a VerifiedTeammateInstruction and TeamPairingSecurityPolicy.change == 'ask', a HumanDecisionReceipt from local HumanPrincipal is required before mutation."
        ],
        "postconditions": [
          "Mutation scope strictly equals the literal range declared in authorization_source.effect."
        ],
        "invariants": [
          "Authorization NEVER inherits across turns.",
          "Operations leaking secrets, performing unrecoverable deletion, or bypassing frago-core hooks are unconditionally forbidden regardless of policy."
        ],
        "side_effects": {
          "mutates": ["Resource"],
          "emits": ["SessionStepEvent"]
        }
      }
    },
    {
      "action_id": "reply_to_inbound_channel",
      "parameters": ["channel_id", "inbound_message_id", "reply_payload"],
      "signature": {
        "initiator_domain": "PrimarySchedulerRole | AgentKernel",
        "target_range": "CommunicationChannel",
        "input_types": {
          "channel_id": "str",
          "inbound_message_id": "str",
          "reply_payload": "str"
        },
        "return_type": "ChannelMessageEvent",
        "error_types": ["ChannelMismatchError", "ChannelDeliveryError"]
      },
      "contract": {
        "preconditions": [
          "channel_id MUST match the originating CommunicationChannel of inbound_message_id (external tasks must reply back to the exact channel they arrived from)."
        ],
        "postconditions": [
          "Emits ChannelMessageEvent with event_type == 'outbound_reply_delivered'."
        ],
        "invariants": [
          "Reply payload MUST NOT contain secrets, tokens, or .env contents."
        ],
        "side_effects": {
          "initiates": "ChannelIngestionProcess",
          "emits": ["ChannelMessageEvent"]
        }
      }
    },
    {
      "action_id": "control_desktop_stage",
      "parameters": ["instance_id", "command_verb", "stage_payload"],
      "signature": {
        "initiator_domain": "AgentKernel | HumanPrincipal | PrimarySchedulerRole",
        "target_range": "VirtualDesktopStage",
        "input_types": {
          "instance_id": "str",
          "command_verb": "str",
          "stage_payload": "dict[str, Any]"
        },
        "return_type": "dict",
        "error_types": ["ForeignScreenOwnershipError", "StageNotRunningError"]
      },
      "contract": {
        "preconditions": [
          "VirtualDesktopStage content_id MUST be derived solely from instance_id (independent of broker port).",
          "Client layout or identify payloads whose content_id mismatches target VirtualDesktopStage MUST be rejected as foreign_clients."
        ],
        "postconditions": [
          "Stopping the broker transitions DesktopInstanceRuntimeState to 'stopped' while preserving the instance registry file intact."
        ],
        "invariants": [
          "VirtualDesktopStage identity fields (id, content_id, desktop_url, clips_dir, created_at) remain immutable across broker restarts."
        ],
        "side_effects": {
          "mutates": ["VirtualDesktopStage"],
          "emits": ["SessionStepEvent"]
        }
      }
    },
    {
      "action_id": "invoke_domain_employee",
      "parameters": ["member_post_id", "query_or_task", "caller_context_id"],
      "signature": {
        "initiator_domain": "HumanPrincipal | PrimarySchedulerRole | DomainEmployeeRole | RecipeModule",
        "target_range": "EmployeePostResource | DomainEmployeeRole",
        "input_types": {
          "member_post_id": "str",
          "query_or_task": "str",
          "caller_context_id": "str"
        },
        "return_type": "dict",
        "error_types": ["EmployeePostNotFoundError", "OutOfScopeRequestError"]
      },
      "contract": {
        "preconditions": [
          "Target EmployeePostResource MUST exist and bind an active AgentKernel via DomainEmployeeRole.",
          "query_or_task MUST fall within the KnowledgeDomain or RecipeModule scope declared by EmployeePostResource."
        ],
        "postconditions": [
          "Returns structured domain answer or execution receipt derived from the bound KnowledgeDomain and RecipeModule DataSlot without polluting the caller session context."
        ],
        "invariants": [
          "DomainEmployeeRole NEVER impersonates HumanPrincipal to issue HumanDecisionReceipt."
        ],
        "side_effects": {
          "initiates": "AgentSessionProcess",
          "emits": ["SessionStepEvent"],
          "produces": ["SessionTranscriptArtifact"]
        }
      }
    },
    {
      "action_id": "govern_employee_domain_assets",
      "parameters": ["member_post_id", "asset_kind", "target_asset_id", "governance_op"],
      "signature": {
        "initiator_domain": "DomainEmployeeRole",
        "target_range": "KnowledgeDomain | RecipeModule | DataSlot | ScheduleRuleSpec",
        "input_types": {
          "member_post_id": "str",
          "asset_kind": "str",
          "target_asset_id": "str",
          "governance_op": "str"
        },
        "return_type": "dict",
        "error_types": ["UnauthorizedTerritoryMutationError"]
      },
      "contract": {
        "preconditions": [
          "target_asset_id MUST be registered inside the territory scope of EmployeePostResource(member_post_id).",
          "If governance_op crosses outside the employee territory or performs irreversible deletion, a HumanDecisionReceipt from HumanPrincipal is required."
        ],
        "postconditions": [
          "Target KnowledgeDomain, RecipeModule, DataSlot, or ScheduleRuleSpec is updated while preserving domain consistency."
        ],
        "invariants": [
          "Autonomous territory maintenance (recipe-data refresh, def knowledge curation, schedule self-alarm) remains strictly bounded to the employee's assigned scope."
        ],
        "side_effects": {
          "initiates": "RecipeExecutionProcess",
          "mutates": ["KnowledgeDomain", "RecipeModule", "DataSlot"],
          "produces": ["DefKnowledgeEntry"]
        }
      }
    }
  ]
}
